# Shareat System environment contract.
# Every variable here is REQUIRED unless marked OPTIONAL.
# Startup FAILS LOUDLY if a required variable is missing or empty (bible §7 rule 9).
# Copy to .env.local and fill in. NEVER commit .env.local.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development

# IANA timezone for all business-day boundaries. Do not change casually —
# payroll periods, attendance days and sales days all derive from this.
# ⚠️ Currently NOT read by packages/core/src/datetime.ts's BUSINESS_TIMEZONE, which is hardcoded
#    to the same value — env() enforces that the two never disagree, but changing this variable
#    alone changes nothing yet (see DEF-315 for the re-wiring). The sentence above describes the
#    INTENT; the mechanism behind it does not exist, which is what DEF-315 records.
APP_TIMEZONE=Asia/Manila

# ---------------------------------------------------------------------------
# Database  (local dev: PostgreSQL 18 on port 5435 — NOT 5432)
# ---------------------------------------------------------------------------
# Local:      postgresql://postgres:PASSWORD@localhost:5435/shareat_dev
# Production: the DO Managed Postgres PRIVATE/VPC connection string (sslmode=require)
#
# DEF-344: TLS comes from THIS URL's own `sslmode`, not from NODE_ENV — packages/db/src/client.ts
# no longer sets an `ssl` option, so postgres.js reads `sslmode` off the string itself. Local has
# none, which already means no TLS (postgres.js's own default); production's string must keep
# `?sslmode=require`, or the connection is silently unencrypted.
DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5435/shareat_dev

# Separate database used by integration tests. It is TRUNCATED between runs,
# so it must never point at a database holding real data.
TEST_DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5435/shareat_test

# Max pool connections. Keep well under the managed cluster's connection limit.
DATABASE_POOL_MAX=10

# OPTIONAL. Same as DATABASE_URL unless explicitly split — reserved for the enumerable
# system-authority call sites named in client.ts's systemTransaction doc comment (T-251a,
# bible §13 row 185). Blank means systemTransaction() falls back to DATABASE_URL.
SYSTEM_DATABASE_URL=

# ---------------------------------------------------------------------------
# Firebase Auth — identity provider ("who you are"). Postgres owns authority.
# ---------------------------------------------------------------------------
# Server-side: the full service-account JSON on one line, or a path via
# GOOGLE_APPLICATION_CREDENTIALS. NEVER commit either.
#
# FIREBASE_PROJECT_ID is the IDENTITY project — the one Ian's email and password actually live in,
# which is v1's project (T-232 decision 1). Email sign-in verifies an ID token against it and
# REFUSES to run without it; PIN sign-in never touches it.
# ⭐ Token verification needs NO service account: `verifyIdToken` checks the signature against
#    Google's PUBLIC keys and only needs to know which project to expect. The service-account key
#    below is for STORAGE and anything else that acts as the project — not for signing people in.
# ⛔ This must match NEXT_PUBLIC_FIREBASE_PROJECT_ID. If the browser signs in against one project
#    and the server verifies against another, every correct password is rejected as unverifiable.
# ⚠️ env() compares this to NEXT_PUBLIC_FIREBASE_PROJECT_ID whenever both are visible in the same
#    process — which, today, is never true in production (the two are set by disconnected
#    mechanisms: this one lives in the droplet's .env.local at runtime, the public one in GitHub
#    Secrets at build time; see DEF-315) and only true in local dev once both are set by hand.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=
# Preferred: a PATH instead of the value. The key never enters an env var, a shell
# history, or a process listing. secrets/ is gitignored except its README.
# ⛔ Setting BOTH forms is rejected rather than silently resolved.
FIREBASE_SERVICE_ACCOUNT_KEY_FILE=

# Storage — the PRIVATE bucket for accounting documents (T-141, bible row 155).
# ⛔ NOT the same value as NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET below. That one is the project's
#    DEFAULT bucket, whose rule is `allow read;` — world-readable and correct for menu photos.
#    Receipts carry suppliers, prices and volumes and are kept for years; they go in a bucket that
#    is deny-all and reachable ONLY through the Admin SDK.
FIREBASE_STORAGE_BUCKET=

# Client-side (safe to expose — these are public by design).
#
# ⚠️ These are inlined at BUILD time, so on production they are the deploy workflow's GitHub
#    Secrets, not the droplet's .env.local. Changing one needs a rebuild, not a restart.
#
# REQUIRED for email sign-in (T-232) — the browser needs all three to talk to the identity project:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# OPTIONAL. Firebase Auth reads neither, and the bucket names the DEFAULT bucket of a DIFFERENT
# project (storage is shareat-hub-v2; identity is v1's) — so a blank one must not be able to hide the
# sign-in form. Whatever needs a bucket or an app id demands it at its own call site.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# DEVELOPMENT ONLY — point the browser at the local emulator suite instead of a real project.
#
# ⛔⛔ NEVER SET EITHER OF THESE IN .env.local, AND THIS IS A CORRECTNESS RULE, NOT TIDINESS.
#    apps/erp/next.config.js loads the repo-root .env.local BEFORE Next reads its config, so that
#    file is read at BUILD time, not only in dev. Set the host there and every local `npm run build`
#    inlines `localhost` into .next — and because NEXT_PUBLIC_* is inlined, a build that captured it
#    CANNOT be corrected at runtime on the droplet. Only a rebuild fixes it.
#    ⭐ Pass them to the dev-server process instead. Production is protected today only by
#    .github/workflows/deploy.yml's explicit env allowlist — scripts/deploy-preflight.ts checks that
#    REQUIRED keys are present and has no denylist, so nothing fails if these are ever added to it.
#
# ⚠️ NEXT_PUBLIC_FIREBASE_EMULATOR_HOST IS A host:port PAIR, AND THE PORT IS THE FIRESTORE ONE.
#    The auth port is separate, below. Passing the raw pair where a hostname is expected builds
#    http://localhost:8182:9198 — which the SDK does NOT reject: it takes the first pair and points
#    auth at the Firestore port, where every request fails opaquely. Strip it: host.split(':')[0].
#
# Ports come from firebase/firebase.json — firestore 8182, auth 9198.
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost:8182
# NEXT_PUBLIC_FIREBASE_AUTH_PORT=9198

# ---------------------------------------------------------------------------
# POS's external, key-scoped API (T-177, docs/CROSS-APP-MAP.md §3) — the daily usage pull's
# snapshot source (`GET {POS_API_URL}/api/external/sold-items`). Optional: nothing outside
# /inventory/pos-usage calls it, so local dev is never blocked on this credential.
# ---------------------------------------------------------------------------
POS_API_URL=
POS_API_KEY=

# ---------------------------------------------------------------------------
# Session — shared-terminal PIN login issues a signed server-side token (§7.1).
# Generate with:  openssl rand -base64 48
# MUST fail closed: no default, no fallback value, ever.
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# ETL capture credentials         (OPTIONAL — only `capture` mode needs these)
# ---------------------------------------------------------------------------
# READ-ONLY service accounts for the two LIVE Firebase projects the ETL reads
# from. Used by `packages/etl` capture runs only. Nothing else in this repo
# reads them, and capture NEVER falls back to FIREBASE_SERVICE_ACCOUNT_KEY —
# that is a different credential for a different purpose (the auth bridge).
#
# ⚠️ These reach PRODUCTION data. Grant the LEAST privilege that works:
#    roles/datastore.viewer  (Cloud Datastore Viewer) — and NOTHING else.
#    NOT roles/datastore.user, which is read AND WRITE.
#    The Admin SDK ignores Firestore security rules entirely, so this IAM role
#    is the ONLY control on the key. Firestore IAM is also project-wide — there
#    is no way to scope it to particular collections — so viewer-vs-user is the
#    whole difference between a leaked key exposing data and a leaked key being
#    able to change the live books.
#    The ETL cannot mutate the source by design (SourceReader declares no
#    write method) — a read-only key makes that structural instead of
#    merely intended.
#
# ⚠️ LOCAL ONLY. Never set these in a deployed environment; the running app
#    has no reason to hold a credential to the old system.
#
# PREFERRED — point at the JSON file by PATH. The key then never enters an
# env var, a shell history, a process listing, or a `printenv` dump.
# secrets/ is gitignored; see secrets/README.md.
#   ERP v1 project: studio-7300228488-a394e
#   POS/hub project: shareat-hub-v2
CAPTURE_ERP_SA_KEY_FILE=./secrets/erp.sa.json
CAPTURE_HUB_SA_KEY_FILE=./secrets/hub.sa.json

# ALTERNATIVE — the full service-account JSON collapsed ONTO ONE LINE, exactly
# as FIREBASE_SERVICE_ACCOUNT_KEY above. Leave the escaped newlines inside
# private_key exactly as they appear in the downloaded file — do NOT expand
# them into real line breaks, or the key will not parse.
# Setting BOTH the _FILE and inline form for one credential is REJECTED, not
# silently resolved: "which key did it actually use" is the worst question to
# have to ask about a production credential.
CAPTURE_ERP_SA_KEY=
CAPTURE_HUB_SA_KEY=

# Pseudonymisation salt — NOT a Google credential. Staff names, phone numbers
# and customer identifiers are hashed with it before a specimen is written to
# the corpus. Generate with:  openssl rand -base64 32
# Changing it re-pseudonymises everything, so pick one and keep it.
CAPTURE_SALT=

# ---------------------------------------------------------------------------
# Observability                                       (OPTIONAL — has defaults)
# ---------------------------------------------------------------------------
LOG_LEVEL=info
