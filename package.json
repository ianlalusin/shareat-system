{
  "name": "shareat-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/erp"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @shareat/erp",
    "build": "npm run build -w @shareat/erp",
    "start": "npm run start -w @shareat/erp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "capture": "tsx scripts/capture.ts",
    "db:generate": "npm run db:generate -w @shareat/db",
    "db:migrate": "npm run db:migrate -w @shareat/db",
    "db:studio": "npm run db:studio -w @shareat/db",
    "check": "npm run typecheck && npm run test",
    "audit": "tsx scripts/audit.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
