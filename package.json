{
  "name": "shareat-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/erp",
    "apps/pos",
    "apps/customer"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @shareat/erp",
    "build": "npm run build -w @shareat/erp",
    "start": "npm run start -w @shareat/erp",
    "dev:pos": "npm run dev -w @shareat/pos",
    "dev:customer": "npm run dev -w @shareat/customer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration --reporter=verbose",
    "test:all": "vitest run",
    "capture": "tsx scripts/capture.ts",
    "master-data": "tsx scripts/master-data.ts",
    "dual-run": "tsx scripts/dual-run.ts",
    "db:generate": "npm run db:generate -w @shareat/db",
    "db:migrate": "npm run db:migrate -w @shareat/db",
    "provision-test-role": "node scripts/provision-test-role.mjs",
    "write-revision": "node scripts/write-revision.mjs",
    "dev:seed:inventory": "tsx scripts/dev-seed-inventory.ts",
    "db:studio": "npm run db:studio -w @shareat/db",
    "check": "npm run typecheck && npm run test",
    "audit": "tsx scripts/audit.ts",
    "cutover:purge": "tsx scripts/cutover-purge.ts",
    "cutover:rehearse": "tsx scripts/cutover-rehearsal.ts",
    "toc": "tsx scripts/gen-toc.ts",
    "month-end": "tsx scripts/month-end.ts",
    "dev:seed": "tsx scripts/dev-seed.ts",
    "storage-smoke": "tsx scripts/storage-smoke.ts",
    "smoke:pin-throttle": "tsx scripts/smoke-pin-throttle.ts",
    "capture:attendance-golden": "tsx scripts/capture-attendance-golden.ts",
    "attendance-sweep": "tsx scripts/attendance-sweep.ts",
    "firestore-relay": "tsx scripts/firestore-relay.ts",
    "finding-observation": "tsx scripts/finding-observation.ts",
    "order-wastage-backstop": "tsx scripts/order-wastage-backstop.ts",
    "orphan-file-sweep": "tsx scripts/orphan-file-sweep.ts",
    "budget-reissue": "tsx scripts/budget-reissue.ts",
    "recurring-expense-draft": "tsx scripts/recurring-expense-draft.ts",
    "usage-auto-post": "tsx scripts/usage-auto-post.ts",
    "pos-day-import": "tsx scripts/pos-day-import.ts",
    "pos-receipt-bridge": "tsx scripts/pos-receipt-bridge.ts",
    "inter-entity-reconcile": "tsx scripts/inter-entity-reconcile.ts",
    "fiscal-period-seed": "tsx scripts/fiscal-period-seed.ts",
    "bootstrap-org": "tsx scripts/bootstrap-org.ts",
    "onboard-franchise": "tsx scripts/onboard-franchise.ts",
    "provision-terminal": "tsx scripts/provision-terminal.ts",
    "backfill-fiscal-periods": "tsx scripts/backfill-fiscal-periods.ts",
    "backfill-canonical-positions": "tsx scripts/backfill-canonical-positions.ts",
    "backfill-store-attendance-config": "tsx scripts/backfill-store-attendance-config.ts",
    "backfill-file-links": "tsx scripts/backfill-file-links.ts",
    "deploy-preflight": "tsx scripts/deploy-preflight.ts",
    "db-backup": "tsx scripts/db-backup.ts",
    "restore-drill": "tsx scripts/restore-drill.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-storage": "^3.1149.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "fast-check": "^3.23.2",
    "happy-dom": "^21.0.4",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
