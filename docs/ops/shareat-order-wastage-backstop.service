# T-178 / DEF-226 — the 15-day order-wastage backstop. INSTALL INSTRUCTIONS: docs/ops/README.md
#
# ⛔ Runs as a `system` principal with no session and no person. T-140's decision, unchanged:
# a service account holding an admin role is a standing credential nobody watches.
#
# ⭐ What it is for: a tracked order wastage sits open until a human resolves it. Past 15 days this
# job closes it uniformly — allocated split charged, else the Wastage Monitor, else the store
# absorbs net-zero — including disputed records, deliberately, per task 178 invariant 4.

[Unit]
Description=Shareat — 15-day order-wastage auto-charge backstop (T-178 / DEF-226)
After=network-online.target
Wants=network-online.target
# No After=postgresql.service — the database is DO Managed Postgres, off-box (ADR-002 §1).

[Service]
Type=oneshot
WorkingDirectory=/srv/shareat
ExecStart=/usr/bin/npm run order-wastage-backstop
User=shareat
Group=shareat

# ⚠️ NEVER build here. This is a 2 GB droplet; a build OOMs it. This unit runs an
# already-installed tree shipped by CI — bible §2.10.
Environment=NODE_ENV=production

# ⭐ The exit code is load-bearing: non-zero when anything failed, so the host's mailer speaks up.
StandardOutput=append:/var/log/shareat/order-wastage-backstop.log
StandardError=append:/var/log/shareat/order-wastage-backstop.log
