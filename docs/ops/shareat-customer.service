# T-455 S9a - the customer app's web process (the lobby at order.shareat.net). INSTALL INSTRUCTIONS: docs/ops/customer-lobby-runbook.md
#
# Third long-running web process beside shareat-erp.service (9008) and shareat-pos.service (9009) on the production droplet (159.223.46.224). Binds 127.0.0.1:9010 only
# (`next start -p 9010 -H 127.0.0.1`, apps/customer/package.json); Caddy is the public listener and sets X-Real-IP. Port 9010 is THIS repo's customer port; the 9004 in the
# old global table belongs to the retired CUSTOMER repo.

[Unit]
Description=Shareat System - customer app / lobby (next start)
After=network-online.target
Wants=network-online.target
# Do NOT add After=postgresql.service - the database is DO Managed Postgres, off-box (ADR-002 s1 Option B).

[Service]
Type=simple
WorkingDirectory=/srv/shareat/apps/customer
ExecStart=/usr/bin/npm run start
User=shareat
Group=shareat
Restart=always
RestartSec=5

# NEVER build here. This is a 4 GB droplet shared with the ERP and POS; a build OOMs it. This unit runs an already-built tree shipped by CI (bible 2.10).
# NEXT_PUBLIC_LOBBY_DEMO must never be set anywhere near this unit: it switches the screens to a fixture.
Environment=NODE_ENV=production
# LOBBY_HASH_SECRET (32+ random characters, generated on the box), LOBBY_ORG_ID and DATABASE_URL. Without this file every /api/lobby/* route answers 503.
EnvironmentFile=/srv/shareat-shared/customer.env

# The customer process must never starve the ERP and POS on a 4 GB box.
MemoryMax=512M

StandardOutput=append:/var/log/shareat/customer.log
StandardError=append:/var/log/shareat/customer.log

[Install]
WantedBy=multi-user.target
