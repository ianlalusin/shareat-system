# T-205 — month-end close (depreciation, amortisation). INSTALL INSTRUCTIONS: docs/ops/README.md
#
# ⛔ Runs as a `system` principal with no session and no person. T-140's decision, unchanged:
# a service account holding an admin role is a standing credential nobody watches.
#
# ⭐ This is the job whose ABSENCE is the whole reason this business keeps a defects register:
# v1's depreciation cron never existed despite the seed data's own comment claiming it did
# (docs/ops/README.md's history table). Installing the timer is the finish line, not the code.

[Unit]
Description=Shareat — month-end close (depreciation and amortisation)
After=network-online.target
Wants=network-online.target
# No After=postgresql.service — the database is DO Managed Postgres, off-box (ADR-002 §1).

[Service]
Type=oneshot
WorkingDirectory=/srv/shareat
ExecStart=/usr/bin/npm run month-end
User=shareat
Group=shareat

# ⚠️ NEVER build here. This is a 2 GB droplet; a build OOMs it. This unit runs an
# already-installed tree shipped by CI — bible §2.10.
Environment=NODE_ENV=production

# ⭐ The exit code is load-bearing: non-zero when anything failed, so the host's mailer speaks up.
StandardOutput=append:/var/log/shareat/month-end.log
StandardError=append:/var/log/shareat/month-end.log
