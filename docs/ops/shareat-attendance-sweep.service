# T-199 — the missed clock-out sweep. INSTALL INSTRUCTIONS: docs/ops/README.md
#
# ⛔ Runs as a `system` principal with no session and no person. T-140's decision, unchanged:
# a service account holding an admin role is a standing credential nobody watches.

[Unit]
Description=Shareat — close shifts nobody clocked out of
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/shareat
ExecStart=/usr/bin/npm run attendance-sweep
User=shareat
Group=shareat

# ⚠️ NEVER build here. The droplet is 4 GB and runs Postgres; a build OOMs the box and takes the
# database down with it. This unit runs an already-installed tree — bible §2.10.
Environment=NODE_ENV=production

# ⭐ The exit code is load-bearing: non-zero when anything failed, so the host's mailer speaks up.
StandardOutput=append:/var/log/shareat/attendance-sweep.log
StandardError=append:/var/log/shareat/attendance-sweep.log
