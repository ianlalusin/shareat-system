# T-401 S6 (audit ruling A1) - the next-afternoon auto-post of POS-pull usage drafts. INSTALL INSTRUCTIONS: docs/ops/README.md
#
# Runs as a `system` principal, per org, with no session and no person. T-140's decision, unchanged: a service account holding an
# admin role is a standing credential nobody watches.
#
# What it is for: finalizing the v1 POS pull makes a usage DRAFT at the expected quantities. A manager posts it after staff correct
# it. A system-made pull draft nobody posted by 14:00 Manila the day after its business date (and at least four hours after it was
# made) is posted by this job: in-band lines as they stand, out-of-band lines at expected, marked auto_posted and audited.

[Unit]
Description=Shareat - next-afternoon auto-post of POS-pull usage drafts, per org (T-401 S6)
After=network-online.target
Wants=network-online.target
# No After=postgresql.service - the database is DO Managed Postgres, off-box (ADR-002 section 1).

[Service]
Type=oneshot
WorkingDirectory=/srv/shareat
ExecStart=/usr/bin/npm run usage-auto-post
User=shareat
Group=shareat

# NEVER build here. This is a 2 GB droplet; a build OOMs it. This unit runs an already-installed tree shipped by CI - bible 2.10.
Environment=NODE_ENV=production

# The exit code is load-bearing: non-zero when any draft was left unposted (a room under count, a closed stock month, a short item)
# or an org failed, so systemd shows the unit failed and the host's mailer speaks up.
StandardOutput=append:/var/log/shareat/usage-auto-post.log
StandardError=append:/var/log/shareat/usage-auto-post.log
