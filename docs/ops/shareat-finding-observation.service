# T-214 — the daily finding-observation run. INSTALL INSTRUCTIONS: docs/ops/README.md
#
# ⛔ Runs as a `system` principal with no session and no person. T-140's decision, unchanged:
# a service account holding an admin role is a standing credential nobody watches.
#
# ⭐ What it is for: a finding is a pure function of current state and carries NO CLOCK, so when a
# condition first appeared is not recoverable from anywhere. This job is the clock. Miss a day and
# nothing is corrupted — but that day is gone, because it cannot be reconstructed afterwards, and
# every age on the scorecard is measured from what this job saw.

[Unit]
Description=Shareat — record which integrity findings held today (T-214)
After=network-online.target
Wants=network-online.target
# No After=postgresql.service — the database is DO Managed Postgres, off-box (ADR-002 §1).

[Service]
Type=oneshot
WorkingDirectory=/srv/shareat
ExecStart=/usr/bin/npm run finding-observation
User=shareat
Group=shareat

# ⚠️ NEVER build here. This is a 2 GB droplet; a build OOMs it. This unit runs an
# already-installed tree shipped by CI — bible §2.10.
Environment=NODE_ENV=production

# ⭐ The exit code is load-bearing: non-zero when anything failed, so the host's mailer speaks up.
StandardOutput=append:/var/log/shareat/finding-observation.log
StandardError=append:/var/log/shareat/finding-observation.log
