# env — NEVER commit real secrets. .env.example is the committed contract.
.env
.env.local
.env.*.local
*.pem

# Service-account key files. The ETL capture credentials live in secrets/ as
# JSON files; the directory is ignored wholesale and only its README is tracked.
# The filename patterns below are deliberately ALSO matched outside secrets/,
# because the real failure mode is a key downloaded to the repo root and swept
# up by `git add -A` before anyone notices. Google's own download name matches
# *firebase-adminsdk*.json.
secrets/*
!secrets/README.md
*-service-account*.json
*serviceaccount*.json
*firebase-adminsdk*.json
*.sa.json

# The GCP console names a downloaded key <project-id>-<12 hex chars>.json, which
# matched NOTHING above. A real key landed at the repo root un-ignored on
# 2026-08-23 and was caught only because it had not been staged yet. Both halves
# of the fix are below: the generic shape, and the four project ids by name.
# gitignore has character classes but no quantifiers, hence twelve brackets.
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
studio-7300228488-a394e*.json
studio-9137697931-f4a93*.json
shareat-hub-v2*.json
shareatv5*.json

