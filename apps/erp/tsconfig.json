{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@shareat/core": ["../../packages/core/src/index.ts"],
      "@shareat/core/*": ["../../packages/core/src/*"],
      "@shareat/db": ["../../packages/db/src/index.ts"],
      "@shareat/db/pos-v1/wire": ["../../packages/db/src/pos-v1/wire.ts"],
      "@shareat/db/schema": ["../../packages/db/schema/index.ts"],
      "@shareat/db/client": ["../../packages/db/src/client.ts"],
      "@shareat/domain/money-lines": ["../../packages/domain/src/shared/money-lines.ts"],
      "@shareat/domain/money-input": ["../../packages/domain/src/shared/money-input.ts"],
      "@shareat/domain/item-code": ["../../packages/domain/src/item-code.ts"],
      "@shareat/domain/item-import-limits": ["../../packages/domain/src/items/import-limits.ts"],
      "@shareat/domain/files/limits": ["../../packages/domain/src/files/limits.ts"],
      "@shareat/domain/field-rules": ["../../packages/domain/src/field-rules/index.ts"],
      "@shareat/domain/business-rules": ["../../packages/domain/src/business-rules/index.ts"],
      "@shareat/domain/expenses/allocate": ["../../packages/domain/src/expenses/allocate.ts"],
      "@shareat/domain/refusal-leaf": ["../../packages/domain/src/shared/refusal-leaf.ts"],
      "@shareat/domain/attendance/fingerprint": ["../../packages/domain/src/attendance/fingerprint/index.ts"],
      "@shareat/domain/pos/price": ["../../packages/domain/src/pos/price.ts"],
      "@shareat/domain": ["../../packages/domain/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
