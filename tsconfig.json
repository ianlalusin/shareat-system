{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@shareat/core": [
        "./packages/core/src/index.ts"
      ],
      "@shareat/core/*": [
        "./packages/core/src/*"
      ],
      "@shareat/db": [
        "./packages/db/src/index.ts"
      ],
      "@shareat/db/schema": [
        "./packages/db/schema/index.ts"
      ],
      "@shareat/db/client": [
        "./packages/db/src/client.ts"
      ],
      "@shareat/domain": [
        "./packages/domain/src/index.ts"
      ],
      "@shareat/domain/*": [
        "./packages/domain/src/*"
      ],
      "@shareat/auth": [
        "./packages/auth/src/index.ts"
      ],
      "@shareat/auth/*": [
        "./packages/auth/src/*"
      ],
      "@shareat/etl": [
        "./packages/etl/src/index.ts"
      ],
      "@shareat/etl/*": [
        "./packages/etl/src/*"
      ],
      "@shareat/etl-firestore": [
        "./packages/etl-firestore/src/index.ts"
      ],
      "@shareat/etl-firestore/*": [
        "./packages/etl-firestore/src/*"
      ],
      "@/*": [
        "./apps/erp/src/*"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "etl/**/*.ts",
    "scripts/**/*.ts",
    "apps/erp/next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/.next"
  ]
}
